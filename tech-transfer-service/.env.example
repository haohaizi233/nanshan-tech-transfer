# ============================================================
# tech-transfer-service 环境配置模板（T006 统一配置）
#
# 使用：复制本文件为 .env（Windows: copy .env.example .env），
#       按部署环境修改取值；也可只设进程环境变量（优先级更高）。
#
# 读取优先级（高 → 低）：
#   1. 进程环境变量
#   2. .env.{APP_ENV}（环境特定覆盖文件，可选，如 .env.staging）
#   3. .env（本文件复制出来的基础文件）
#   4. config.py 代码默认值（仅适配本地开发）
#
# 安全：.env / .env.* 已被 .gitignore 忽略，真实密钥不得提交仓库；
#       本模板中的密码/密钥均为占位或本地开发默认值。
# ============================================================

# ── 运行环境：local | development（两者等价）/ staging / production ──
APP_ENV=development

# ── 应用 ──
APP_NAME=tech-transfer-service
APP_VERSION=1.0.0
# DEBUG=true 时 uvicorn 开启热重载；staging/production 必须为 false（启动断言拦截）
DEBUG=true
HOST=0.0.0.0
PORT=8787

# ── 宿主与身份（staging/production 禁止 local/mock，启动断言拦截）──
HOST_MODE=local
AUTH_PROVIDER=mock

# ── 对外 API 地址（staging/production 必须为真实域名，禁止 127.0.0.1/localhost）──
API_BASE=http://127.0.0.1:8787

# ── 业务库 PostgreSQL（psycopg2 连接）──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=tech_transfer

# ── 存量资本库 MySQL（仅 tools/etl_institutions.py 过渡期使用，运行时不需要）──
CAPITAL_DB_HOST=127.0.0.1
CAPITAL_DB_PORT=3306
CAPITAL_DB_USER=root
CAPITAL_DB_PASSWORD=123456

# ── JWT（staging/production 必须换成 ≥16 位随机强密钥，弱值启动断言拦截）──
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES=7200
REFRESH_TOKEN_EXPIRES_DAYS=14

# ── CORS 白名单（逗号分隔；staging/production 需显式列出前端域名）──
# 开发环境无需配置：本地 regex 自动放行 5173 dev server 与 8077 frp 隧道入口
CORS_ORIGINS=

# ── 文件代理 ──
# 深圳技交中心文件下载地址模板（第三方源站）
SZTE_FILE_URL=https://www.szte.com/portalapi/system/file/v1/downloadFile?fileId={file_id}
# 文件本地缓存目录（相对 tech-transfer-service/，也可配绝对路径）
FILE_CACHE_DIR=cache/logos
