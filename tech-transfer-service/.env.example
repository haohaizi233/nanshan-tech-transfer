# ============================================================
# tech-transfer-service 环境配置模板（T006 统一配置）
#
# 使用：复制本文件为 .env（Windows: copy .env.example .env），
#       按部署环境修改取值；也可只设进程环境变量（优先级更高）。
#
# 读取优先级（高 → 低）：
#   1. 进程环境变量
#   2. .env.{APP_ENV}（环境特定覆盖文件，可选，如 .env.staging）
#   3. .env（本文件复制出来的基础文件）
#   4. config.py 代码默认值（仅适配本地开发）
#
# 安全：.env / .env.* 已被 .gitignore 忽略，真实密钥不得提交仓库；
#       本模板中的密码/密钥均为占位或本地开发默认值。
# ============================================================

# ── 运行环境：local | development（两者等价）/ staging / production ──
APP_ENV=development

# ── 应用 ──
APP_NAME=tech-transfer-service
APP_VERSION=1.0.0
# DEBUG=true 时 uvicorn 开启热重载；staging/production 必须为 false（启动断言拦截）
DEBUG=true
HOST=0.0.0.0
PORT=8787

# ── 宿主与身份（staging/production 禁止 local/mock，启动断言拦截）──
HOST_MODE=local
AUTH_PROVIDER=mock

# ── 微信小程序凭证（AppID 与前端 manifest.json/project.config.json 保持一致；
#    AppSecret 在 mp.weixin.qq.com「开发管理-开发设置」获取，仅供后端 code2session 使用）──
WECHAT_APPID=
WECHAT_APP_SECRET=

# ── 对外 API 地址（staging/production 必须为真实域名，禁止 127.0.0.1/localhost）──
API_BASE=http://127.0.0.1:8787

# ── 业务库 PostgreSQL（psycopg2 连接）──
DB_HOST=192.168.2.79
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=tech_transfer
# 连接池：单进程同时借出上限；「我的」页会并发多个 /me/* 查询
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT=3

# ── 存量资本库 MySQL（仅 tools/etl_institutions.py 过渡期使用，运行时不需要）──
# R2: 占位符替换弱口令 123456
CAPITAL_DB_HOST=127.0.0.1
CAPITAL_DB_PORT=3306
CAPITAL_DB_USER=root
CAPITAL_DB_PASSWORD=<YOUR_CAPITAL_DB_PASSWORD>

# ── JWT（staging/production 必须换成 ≥16 位随机强密钥，弱值启动断言拦截）──
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
# R7: 可配置的 token 过期时间（秒/天）
ACCESS_TOKEN_EXPIRES=7200
REFRESH_TOKEN_EXPIRES_DAYS=14

# ── CORS 白名单（逗号分隔；staging/production 需显式列出前端域名）──
# 开发环境无需配置：本地 regex 自动放行 5173 dev server 与 8077 frp 隧道入口
# Caddy 同源转发（页面与 /api 同域名）时浏览器不走 CORS，可留空
CORS_ORIGINS=

# ── 用户上传媒体 ──
# 生产环境必须配置为代码目录外的持久化卷；本地默认同 config.py（LOCALAPPDATA/NanshanTechTransfer/media）
# R5: 请根据部署环境配置合适的路径（POSIX 或 Windows）
MEDIA_ROOT=
MAX_UPLOAD_BYTES=20971520
MAX_IMPORT_BYTES=83886080

# ── 文件代理 ──
# 深圳技交中心文件下载地址模板（第三方源站）
SZTE_FILE_URL=https://www.szte.com/portalapi/system/file/v1/downloadFile?fileId={file_id}
# 文件本地缓存目录（相对 tech-transfer-service/，也可配绝对路径）
FILE_CACHE_DIR=cache/logos

# ── 专利检索 Provider（密钥只放服务端，禁止写入前端仓库）──
# R6: 使用占位符替换内网 IP
PATENT_PROVIDER_BASE=http://<YOUR_PATENT_PROVIDER_HOST>:8081
PATENT_PROVIDER_KEY=
PATENT_PROVIDER_TIMEOUT=45
PATENT_PDF_TIMEOUT=60

# ── AI 能力（与 南山小程序/南山/config/feature-flags.js 同步）──
AI_FEATURE_ENABLED=true

# ── nanshan-ai-agent 配置（E8: 补充完整配置示例）──
AI_AGENT_URL=http://127.0.0.1:8001/api/ai/chat
AI_AGENT_TIMEOUT=30
AI_MAX_CONCURRENT=4
MAX_REQUEST_SECONDS=60

# ── 日志落盘（E7: LOG_DIR 配置示例）──
# 空=仅控制台；非空=落盘到该目录（RotatingFileHandler 20MB×5）
LOG_DIR=
LOG_LEVEL=INFO

# ── 爱马仕 Hermes（OpenAI 兼容 HTTP）。企微长连接由远端 gateway 持有，勿嵌进 FastAPI ──
# AI_PROVIDER_BASE=http://<hermes-host>:8642/v1
AI_PROVIDER_BASE=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=hermes-agent
AI_PROVIDER_TIMEOUT=120
# WECOM_BOT_ID=
# WECOM_SECRET=
# WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com