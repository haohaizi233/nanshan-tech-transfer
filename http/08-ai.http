###############################################################################
# AI（tech-transfer-service 转发层）
# 依赖：userLogin；AI_FEATURE_ENABLED=true 且 ai-agent 可达
###############################################################################

@api = {{baseUrl}}/api/tech-transfer/v1
@auth = Bearer {{userToken}}

### 创建成果评估任务（异步 202）
# @name createEvalTask
POST {{api}}/ai/evaluation-tasks
Authorization: {{auth}}
Content-Type: application/json
X-Idempotency-Key: eval-http-{{$uuid}}

{
  "achievementId": {{publishedAchievementId}}
}

> {%
if (response.body && response.body.data) {
  client.global.set("taskId", String(response.body.data.id || response.body.data.taskId || ""));
}
%}

### 评估任务详情（轮询）
GET {{api}}/ai/evaluation-tasks/{{taskId}}
Authorization: {{auth}}

### 自然语言对话：找成果
# @name aiChatAchievement
POST {{api}}/ai/chat
Authorization: {{auth}}
Content-Type: application/json

{
  "message": "帮我找人工智能、机器视觉相关的科技成果"
}

### 自然语言对话：找需求
POST {{api}}/ai/chat
Authorization: {{auth}}
Content-Type: application/json

{
  "message": "有没有生物医药方面的技术需求"
}

### 对话失败：空 message
POST {{api}}/ai/chat
Authorization: {{auth}}
Content-Type: application/json

{
  "message": "   "
}

### 需求-成果匹配（仅需求 owner + published/matched）
POST {{api}}/ai/match
Authorization: {{auth}}
Content-Type: application/json

{
  "demandId": {{publishedDemandId}}
}

### 聊天历史
GET {{api}}/ai/chat/messages
Authorization: {{auth}}

### 清空聊天历史
DELETE {{api}}/ai/chat/messages
Authorization: {{auth}}

### 持久对话（新模式默认关闭；未启用时按原接口同步返回）
# @name durableChat
POST {{api}}/ai/chat
Authorization: {{auth}}
Content-Type: application/json
Prefer: respond-async

{
  "message": "推荐机器视觉成果",
  "turnId": "http-chat-{{$timestamp}}"
}

> {%
if (response.status === 202 && response.body && response.body.data) {
  client.global.set("chatTurnId", response.body.data.turnId);
}
%}

### 查询已受理轮次（只读，不会重新生成）
GET {{api}}/ai/chat/turns/{{chatTurnId}}
Authorization: {{auth}}

### 继续追问（上下文由服务端生成，需新模式与前一轮成功）
POST {{api}}/ai/chat
Authorization: {{auth}}
Content-Type: application/json
Prefer: respond-async

{
  "message": "预算改成30万元以内",
  "turnId": "http-followup-{{$timestamp}}"
}
