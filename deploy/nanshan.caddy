# 南山科转通 · Caddy 反向代理片段（被 Caddyfile / Caddyfile.h5 import）

(nanshan_api) {
	reverse_proxy {$NS_API_UPSTREAM:127.0.0.1:8025} {
		header_up Host {host}
		header_up X-Request-Id {header.X-Request-Id}
		header_up X-Idempotency-Key {header.X-Idempotency-Key}
		header_up Authorization {header.Authorization}
		transport http {
			dial_timeout 10s
			# AI 评估/对话最长 ~90s，第三方 Provider ~120s；网关须 ≥ 最慢上游首字节时间，
			# 否则上游仍在跑而网关已向客户端返回 502。提到 130s 留足余量。
			response_header_timeout 130s
			read_timeout 180s
			write_timeout 180s
		}
	}
}

(nanshan_h5) {
	reverse_proxy {$NS_H5_UPSTREAM:127.0.0.1:5173} {
		header_up Host {host}
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
	}
}
