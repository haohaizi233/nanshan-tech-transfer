# 南山科转通 · Caddy 反向代理
#
# 同一域名 inanshan.sjhcip.com（可用 NS_SITE 覆盖）同时托管三套入口：
#
#   https://inanshan.sjhcip.com/health   FastAPI :8025（存活检查）
#   https://inanshan.sjhcip.com/api/*    FastAPI :8025（接口、/api/health）
#   https://inanshan.sjhcip.com/h5/      小程序 H5（经 FastAPI 反代本机 :5173）
#   https://inanshan.sjhcip.com/         其余 → FastAPI（后台 SPA /login /admin /assets、/docs）
#
# 对外 HTTPS 在 43.138.138.200 上由本文件终结。VPS Caddy 反代 127.0.0.1:8025，
# 本机 FastAPI 仍听 8787，必须由 frpc 转到 8025，否则 Caddy 会 502：
#
#   [[proxies]]
#   name = "nanshan-caddy-api"
#   type = "tcp"
#   localIP = "127.0.0.1"
#   localPort = 8787
#   remotePort = 8025
#
# 本机直接听 8025 时，Caddy 反代 127.0.0.1:8025，无需改 remotePort。
# 本机 start_dev.py 会把 NS_API_UPSTREAM 设为 127.0.0.1:8787，避免和本地 FastAPI 端口打架。
#
# 后台与 H5 都默认占用 /assets，所以 H5 必须挂在 /h5/ 前缀下，不能和后台抢根路径。
# 微信原生小程序页面不经过 Caddy，只需把 request 合法域名和 API_BASE 指到本域名。
#
# 启动（一般由 start_dev.py 一键拉起）：
#   caddy run --config deploy/Caddyfile
#   caddy run --config deploy/Caddyfile.h5   # 与本文件等价，保留旧命令
#
# 环境变量：
#   NS_SITE            站点域名，默认 inanshan.sjhcip.com
#   NS_API_UPSTREAM    FastAPI，默认 127.0.0.1:8025（VPS）；本机 start_dev 设为 8787
#   NS_H5_UPSTREAM     已废弃：/h5 与 /api 一样走 FastAPI，由后端再转本机 5173
#   NS_TLS_SNIPPET     TLS 片段，默认 tls-acme.caddy；本机 start_dev 用 tls-local.caddy
#
# 只监听 443，不占用 80。Let's Encrypt 走 TLS-ALPN-01（同样只要 443）。
# DNS A 记录需指向 43.138.138.200，并放行 443。
# 验证：
#   curl --resolve inanshan.sjhcip.com:443:43.138.138.200 https://inanshan.sjhcip.com/health
{
	auto_https disable_redirects
}

import nanshan.caddy

https://{$NS_SITE:inanshan.sjhcip.com} {
	encode gzip zstd

	import {$NS_TLS_SNIPPET:tls-acme.caddy}

	handle /health {
		import nanshan_api
	}

	handle /api/* {
		import nanshan_api
	}

	redir /h5 /h5/ 308

	# /h5/ 必须打到 FastAPI（8025/8787）。直接反代 VPS 的 :5173 会 502，
	# 且 Caddy 的 /h5/* 匹配不到恰好是 /h5/ 的请求，会落到 API 返回「接口不存在」。
	@h5 path /h5 /h5/ /h5/*
	handle @h5 {
		import nanshan_api
	}

	handle {
		import nanshan_api
	}
}
